# Secrets — never commit. .env holds the real API key; .env.example holds only
# the variable name with a placeholder value.
.env
.env.*
!.env.example

# Larger validation PDFs used by the retrieval eval. Not ours to redistribute,
# so they are downloaded on demand rather than committed; the eval skips any
# document it cannot find.
data/real/

# Vercel CLI link + pulled dev env (added by `vercel link`)
.vercel
