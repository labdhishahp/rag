# API-layer configuration — SAFE TO COMMIT (names and placeholders only).
#
# GEMINI_API_KEY is NOT set here: src/llm.py and src/embeddings.py read it from
# the project-root .env. Copy that one instead: `cp ../.env.example ../.env`.

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres connection string. Leave unset to use in-memory storage locally.
DATABASE_URL=

# Upload limit in bytes. Vercel caps a request body at 4.5MB.
MAX_UPLOAD_BYTES=4194304

# LLM provider — see src/llm.py create_llm().
LLM_PROVIDER=gemini
