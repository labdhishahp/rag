# API-layer configuration — SAFE TO COMMIT (names and placeholders only).
#
# GEMINI_API_KEY is NOT set here: src/llm.py reads it from the project-root
# .env (../.env relative to this file), exactly as it did for the Streamlit
# app. Copy the root .env.example instead: `cp ../.env.example ../.env`.

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload limit in bytes (default 20MB).
MAX_UPLOAD_BYTES=20971520

# How long an idle session (indexed document + conversation) is kept in memory.
SESSION_TTL_SECONDS=21600

# Max concurrent in-memory sessions before the oldest is evicted.
MAX_SESSIONS=200

# LLM provider — see src/llm.py create_llm().
LLM_PROVIDER=gemini
