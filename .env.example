# Template for .env — SAFE TO COMMIT. Variable names only, never real values.
#
# Setup:
#   cp .env.example .env
#   then edit .env and replace the placeholder with your real key
#
# Get a Gemini API key at: https://aistudio.google.com/apikey

GEMINI_API_KEY=YOUR_KEY_HERE

# Optional. Embedding size; the similarity floors in src/config.py were
# measured at 768, so changing this means re-measuring them.
# EMBEDDING_DIMENSION=768

# Optional. Client-side embedding rate cap. The Gemini free tier allows 100
# embed requests per minute; raise this to match a paid plan.
# EMBEDDING_RPM=90
