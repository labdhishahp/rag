# Template for .env — SAFE TO COMMIT. Variable names only, never real values.
#
# Setup:
#   cp .env.example .env
#   then edit .env and replace the placeholder with your real key
#
# Get a Gemini API key at: https://aistudio.google.com/apikey

GEMINI_API_KEY=YOUR_KEY_HERE

# Optional. Output size for the GEMINI fallback only (bge-small is fixed at
# 384). The similarity floors in src/config.py were measured at 768, so
# changing this means re-measuring them.
# EMBEDDING_DIMENSION=768

# Optional. Client-side rate cap for the Gemini fallback. Its free tier allows
# 100 embed requests per minute; raise this to match a paid plan.
# EMBEDDING_RPM=90

# Hugging Face API token — REQUIRED. It powers the PRIMARY embedding provider
# (BAAI/bge-small-en-v1.5). Without it the app still works, but every document
# is embedded by the Gemini fallback instead.
#
# Create one at https://huggingface.co/settings/tokens ("read" scope is enough
# for inference). Put the real value in .env, never in this file — .env is
# gitignored, this template is committed. When deploying, set it in the
# platform's environment; a deployed function has no .env file to read.
HF_TOKEN=YOUR_TOKEN_HERE

# Optional. Which provider embeds NEW documents, and what to fall back to when
# it is unreachable. Each document records the provider that indexed it and is
# always queried with that same one — see src/embeddings.py.
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_FALLBACK_PROVIDER=gemini

# Shared secret the API requires in an X-API-Key header. Unset means the API is
# open, which is fine locally; on Vercel the app refuses to start without it.
# The frontend keeps this server-side and never sends it to a browser, so the
# same value goes in the frontend's BACKEND_API_KEY.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=

# Per-client rate limits over a rolling window. Sized against the free tiers:
# Gemini allows 20 generations/day per model, so questions are the tighter cap.
# Set a limit to 0 to disable it.
# RATE_LIMIT_WINDOW_SECONDS=3600
# RATE_LIMIT_QUESTIONS=20
# RATE_LIMIT_UPLOADS=10

# Comma-separated browser origins allowed to call the API directly. With the
# frontend proxying through its own /api route, browsers never call this API
# cross-origin, so this only matters for direct access. Never use "*" — the app
# refuses to start with a wildcard on Vercel.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Postgres connection string (Supabase). Unset locally means in-memory storage,
# so no database is needed to run the app locally. On Vercel it is REQUIRED and the app
# refuses to start without it: serverless instances do not persist, so
# in-memory storage would lose every document between requests.
#
# Use Supabase's TRANSACTION POOLER (port 6543), not the direct connection —
# serverless opens and drops connections far too often for a direct one:
#   Supabase dashboard -> Project Settings -> Database -> Connection string
#   -> "Transaction pooler"
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_URL=

# Optional. Which LLM provider answers questions. See backend/src/llm.py — the
# LLMClient abstract base is the seam for swapping providers.
# LLM_PROVIDER=gemini

# Optional. Upload size ceiling in bytes. Defaults to 4MB, deliberately just
# under Vercel's 4.5MB request-body limit so an oversized upload gets our own
# clear message instead of an opaque platform error.
# MAX_UPLOAD_BYTES=4194304
