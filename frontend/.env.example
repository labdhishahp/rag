# SAFE TO COMMIT — names and placeholders only.
#
# Both are SERVER-side (no NEXT_PUBLIC_ prefix), so Next.js never puts them in
# the browser bundle. The browser talks only to this app's own /api route,
# which adds the key and forwards to Python — see app/api/[...path]/route.ts.

# Where the Python API lives. Read at request time, so changing it does not
# require a rebuild (unlike the NEXT_PUBLIC_ variable this replaced).
BACKEND_URL=http://localhost:8000

# Must match API_KEY on the backend. Leave empty for local development if the
# backend has no API_KEY set.
BACKEND_API_KEY=
